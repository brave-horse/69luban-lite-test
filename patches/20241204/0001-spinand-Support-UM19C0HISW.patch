From 415c1c6614f51d6584beea8eddff4903df038d37 Mon Sep 17 00:00:00 2001
From: "jiji.chen" <jiji.chen@artinchip.com>
Date: Wed, 22 Jul 2026 19:14:45 +0800
Subject: [PATCH] spinand: Support UM19C0HISW

Change-Id: I5efc85b9b174c4420b0cb14284ef970e28107908
---
 bsp/peripheral/spinand/Kconfig       |  6 ++
 bsp/peripheral/spinand/SConscript    |  3 +
 bsp/peripheral/spinand/inc/spinand.h |  3 +
 bsp/peripheral/spinand/spinand.c     |  3 +
 bsp/peripheral/spinand/unim.c        | 94 ++++++++++++++++++++++++++++
 5 files changed, 109 insertions(+)
 create mode 100644 bsp/peripheral/spinand/unim.c

diff --git a/bsp/peripheral/spinand/Kconfig b/bsp/peripheral/spinand/Kconfig
index 180ea152c..7b40544ca 100644
--- a/bsp/peripheral/spinand/Kconfig
+++ b/bsp/peripheral/spinand/Kconfig
@@ -99,4 +99,10 @@ config SPI_NAND_FUDANMICRO
 	default n
 	help
 	  Enable this driver for FUDANMICRO SPI NAND flash.
+
+config SPI_NAND_UNIM
+	bool "Support UNIM SPI NAND"
+	default n
+	help
+	  Enable this driver for UNIM SPI NAND flash.
 endif
diff --git a/bsp/peripheral/spinand/SConscript b/bsp/peripheral/spinand/SConscript
index 7931a272f..ba8e81134 100644
--- a/bsp/peripheral/spinand/SConscript
+++ b/bsp/peripheral/spinand/SConscript
@@ -55,6 +55,9 @@ if GetDepend('SPI_NAND_XINCUN'):
 if GetDepend('SPI_NAND_FUDANMICRO'):
     src += Glob('fudanmicro.c')
 
+if GetDepend('SPI_NAND_UNIM'):
+    src += Glob('unim.c')
+
 if GetDepend('LPKG_USING_SPINAND'):
     src += Glob('spinand.c')
     src += Glob('bbt.c')
diff --git a/bsp/peripheral/spinand/inc/spinand.h b/bsp/peripheral/spinand/inc/spinand.h
index 83e57e78a..9a9bb90a1 100644
--- a/bsp/peripheral/spinand/inc/spinand.h
+++ b/bsp/peripheral/spinand/inc/spinand.h
@@ -282,6 +282,9 @@ extern const struct spinand_manufacturer xincun_spinand_manufacturer;
 #ifdef SPI_NAND_FUDANMICRO
 extern const struct spinand_manufacturer fudanmicro_spinand_manufacturer;
 #endif
+#ifdef SPI_NAND_UNIM
+extern const struct spinand_manufacturer unim_spinand_manufacturer;
+#endif
 
 extern struct spi_nand_cmd_cfg cmd_cfg_table[];
 
diff --git a/bsp/peripheral/spinand/spinand.c b/bsp/peripheral/spinand/spinand.c
index 42d3b0b9c..9d4d12c83 100644
--- a/bsp/peripheral/spinand/spinand.c
+++ b/bsp/peripheral/spinand/spinand.c
@@ -70,6 +70,9 @@ static const struct spinand_manufacturer *spinand_manufacturers[] = {
 #ifdef SPI_NAND_FUDANMICRO
     &fudanmicro_spinand_manufacturer,
 #endif
+#ifdef SPI_NAND_UNIM
+    &unim_spinand_manufacturer,
+#endif
 };
 
 #define SPINAND_LIST_NUM \
diff --git a/bsp/peripheral/spinand/unim.c b/bsp/peripheral/spinand/unim.c
new file mode 100644
index 000000000..16fc55033
--- /dev/null
+++ b/bsp/peripheral/spinand/unim.c
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2023-2026, ArtInChip Technology Co., Ltd
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Authors: jiji.chen <jiji.chen@artinchip.com>
+ */
+
+#include "inc/spinand.h"
+#include "inc/manufacturer.h"
+
+#define SPINAND_MFR_UNIM            0xB0
+
+/* UNIM ECC status is at SR[6:4], 3-bit ECC status field */
+#define UNIM_STATUS_ECC_MASK        GENMASK(6, 4)
+#define UNIM_STATUS_ECC_NO_BITFLIPS      (0 << 4)
+#define UNIM_STATUS_ECC_1_BITFLIPS       (1 << 4)
+#define UNIM_STATUS_ECC_UNCOR_ERROR      (2 << 4)
+#define UNIM_STATUS_ECC_4_BITFLIPS       (3 << 4)
+#define UNIM_STATUS_ECC_8_BITFLIPS       (5 << 4)
+
+int um19c0hisw_ecc_get_status(struct aic_spinand *flash, u8 status)
+{
+    switch (status & UNIM_STATUS_ECC_MASK) {
+        case UNIM_STATUS_ECC_NO_BITFLIPS:
+            return 0;
+        case UNIM_STATUS_ECC_1_BITFLIPS:
+            return 1;
+        case UNIM_STATUS_ECC_UNCOR_ERROR:
+            return -SPINAND_ERR_ECC;
+        case UNIM_STATUS_ECC_4_BITFLIPS:
+            return 4;
+        case UNIM_STATUS_ECC_8_BITFLIPS:
+            return 8;
+        default:
+            break;
+    }
+
+    return -SPINAND_ERR;
+}
+
+static int um19c0hisw_ooblayout_user(struct aic_spinand *flash, int section,
+                            struct aic_oob_region *region)
+{
+    if (section > 3)
+        return -SPINAND_ERR;
+
+    /*
+     * Per 512-byte ECC sector: 16 bytes spare area, all ECC-protected.
+     * ECC parity is stored in hidden 88-byte area (not visible with ECC on).
+     * BBM (2 bytes at sector 0, 0x800-0x801) is managed by BBT layer.
+     * User-accessible spare: all 16 bytes per sector starting at offset 0.
+     */
+    region->offset = (16 * section) + 0;
+    region->length = 16;
+
+    return 0;
+}
+
+const struct aic_spinand_info unim_spinand_table[] = {
+    /*devid page_size oob_size block_per_lun pages_per_eraseblock planes_per_lun
+    is_die_select*/
+    /*UM19C0HISW 1Gb 3.3V*/
+    { DEVID(0x1C), PAGESIZE(2048), OOBSIZE(64), BPL(1024), PPB(64), PLANENUM(1),
+      DIE(0), "UM19C0HISW UNIM 128MB: 2048+64@64@1024", cmd_cfg_table,
+      um19c0hisw_ecc_get_status, um19c0hisw_ooblayout_user, 8 },
+};
+
+const struct aic_spinand_info *unim_spinand_detect(struct aic_spinand *flash)
+{
+    u8 *id = flash->id.data;
+
+    if (id[0] != SPINAND_MFR_UNIM)
+        return NULL;
+
+    return spinand_match_and_init(&id[1], unim_spinand_table,
+                                  ARRAY_SIZE(unim_spinand_table));
+};
+
+static int unim_spinand_init(struct aic_spinand *flash)
+{
+    return 0;
+};
+
+static const struct spinand_manufacturer_ops unim_spinand_manuf_ops = {
+    .detect = unim_spinand_detect,
+    .init = unim_spinand_init,
+};
+
+const struct spinand_manufacturer unim_spinand_manufacturer = {
+    .id = SPINAND_MFR_UNIM,
+    .name = "unim",
+    .ops = &unim_spinand_manuf_ops,
+};
