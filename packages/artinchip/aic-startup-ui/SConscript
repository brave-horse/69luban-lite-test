Import('AIC_ROOT')
Import('PRJ_KERNEL')
from building import *
import os

cwd = GetCurrentDir()
CPPPATH = [cwd]

CPPPATH += [os.path.join(AIC_ROOT,
                         'packages/artinchip/lvgl-ui/aic_demo/ptx_demo/app/Mini_Program')]

src = []
install = []

if GetDepend('AIC_STARTUP_UI_SHOW'):
    src = Glob('*.c')

if GetDepend('AIC_STARTUP_UI_SHOW'):
    install=[('assets/', 'data/')]

group = DefineGroup('startup-ui', src, depend = ['AIC_STARTUP_UI_SHOW'], CPPPATH = CPPPATH, INSTALL=install)

Return('group')
