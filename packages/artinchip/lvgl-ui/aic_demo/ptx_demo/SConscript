from building import *
import os

cwd = GetCurrentDir()
src = Glob('*.c')
inc = [cwd]

lvgl_ui_dir = os.path.dirname(os.path.dirname(cwd))
if GetDepend(['LVGL_V_8']):
    inc += [os.path.join(lvgl_ui_dir, 'lvgl_v8', 'lvgl')]
elif GetDepend(['LVGL_V_9']):
    inc += [os.path.join(lvgl_ui_dir, 'lvgl_v9', 'lvgl')]

group = DefineGroup('LVGL-port', src, depend=['AIC_LVGL_PTX_DEMO'],
                    CPPPATH=inc)

Return('group')
